{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {"type": "object", "required": ["name"]}
    },
    "envFrom": {
      "type": "array",
      "items": {"type": "object"}
    },
    "extraVolumes": {
      "type": "array",
      "items": {"type": "object", "required": ["name"]}
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "mountPath"]}
    },
    "replicaCount": {"type": "integer", "minimum": 2},
    "gateway": {
      "type": "object",
      "properties": {
        "shutdownGraceSeconds": {"type": "integer", "minimum": 1},
        "providerSecretEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "secretName", "key"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {"enum": ["ALLOWOPS_DATABASE_URL", "AWS_SHARED_CREDENTIALS_FILE", "AWS_EC2_METADATA_DISABLED"]}
              },
              "secretName": {"type": "string", "minLength": 1},
              "key": {"type": "string", "minLength": 1}
            }
          }
        },
        "certificateTTL": {"type": "string"},
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wait_seconds": {"type": "integer", "minimum": 0, "maximum": 120},
            "max_wait_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "batch_size": {"type": "integer", "minimum": 1, "maximum": 4294967295},
            "max_failures": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "cursorKeySecret": {"type": "string", "minLength": 1},
        "cursorKeyKey": {"type": "string", "minLength": 1},
        "cursorName": {"type": "string", "minLength": 1},
        "maxFileBytes": {"type": "integer", "minimum": 1},
        "persistence": {
          "type": "object",
          "properties": {"size": {"type": "string", "minLength": 1}}
        }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "create": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "create": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "bucket": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string"},
        "use_path_style": {"type": "boolean"},
        "server_side_encryption": {"type": "string", "enum": ["", "AES256", "none"]},
        "existingSecret": {"type": "string", "minLength": 1},
        "credentialsKey": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "partitions": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "months": {"type": "integer", "minimum": 1, "maximum": 120},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
